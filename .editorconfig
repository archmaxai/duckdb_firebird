root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C++ extension sources follow the DuckDB style (tabs).
[*.{cpp,hpp,h,c,cc}]
indent_style = tab
indent_size = 4

[*.rs]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

# Don't reflow trailing whitespace in markdown / SQL fixtures.
[*.{md,sql,test}]
trim_trailing_whitespace = false
