# Connection details for the Firebird server the extension should read.
# Copy to `.env` and fill in. The extension reads these as a fallback when the
# corresponding named parameter / dsn component is not supplied.
#
# NOTE: when exporting these into your shell, beware that `source .env` mangles
# backslashes in Windows paths. Prefer passing the database explicitly, or set
# the variable with single quotes: export FIREBIRD_DATABASE='C:\path\to\db.fdb'

FIREBIRD_HOST=fd7a:115c:a1e0::7f38:6a39
FIREBIRD_PORT=3050
# Database path or alias AS SEEN ON THE FIREBIRD SERVER machine.
FIREBIRD_DATABASE=C:\path\to\DB.fdb
FIREBIRD_USER=your_user
FIREBIRD_PASSWORD=your_password
FIREBIRD_CHARSET=UTF8
